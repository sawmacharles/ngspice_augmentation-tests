.tran 10n 20.0u 0 uic
.options reltol=1e-3 abstol=1e-9 vntol=1e-6 klu

.control
set filetype=ascii
rusage cputime
run
rusage cputime
meas tran vout_avg_final AVG v(vout) FROM=18.0u TO=20.0u
meas tran vout_max_final MAX v(vout) FROM=18.0u TO=20.0u
meas tran vout_min_final MIN v(vout) FROM=18.0u TO=20.0u
let vout_ripple = vout_max_final - vout_min_final
meas tran duty_meas AVG v(pwm) FROM=9.0u TO=10.0u
meas tran wave_t1 find v(vout) at=5.0u
meas tran wave_t2 find v(vout) at=10.0u
meas tran wave_t3 find v(vout) at=15.0u
meas tran wave_t4 find v(vout) at=20.0u
meas tran wave_sw_t1 find v(sw) at=10.0u
meas tran wave_mesh_far find v(tree_3279) at=20.0u
print vout_avg_final vout_max_final vout_min_final vout_ripple duty_meas wave_t1 wave_t2 wave_t3 wave_t4 wave_sw_t1 wave_mesh_far
rusage cputime
wrdata $HOME/Work/data/ngspice_augmentation/accel/bench/h_pex_tree_sparse/wave.txt v(vout) v(sw) i(l1)
quit
.endc
.end
