* h_pex_tree_sparse -- PEX-sized synchronous buck, synthetic
* (ngspice_augmentation card #467/#478, plan T9.1/T9.2; generated by
* bench/gen_pex_buck.py --topology tree -- do not hand-edit,
* regenerate instead). Not derived from any real deck.
*
* Power stage / compensator topology as refs/r3_vm_buck.cir (12V->3.3V,
* fs=500kHz; see that file for the full compensator design derivation) but:
*  - HS/LS switches are 4/4-finger BSIM4 (level=54)
*    arrays instead of smooth B-source ideal switches (device-eval load).
*  - a tree-shaped synthetic PEX net (3280 nodes: branch=3, depth=7, plus local-mesh loops and cross-subtree coupling caps -- see bench/gen_pex_buck.py's tree_lines() docstring) is coupled onto vout
*    (matrix-size load; ~3280 extra unknowns, sparse).
* run: ngspice -b <this file>  (writes to
*  ~/Work/data/ngspice_augmentation/accel/bench/<deck>/, never into the repo)

.param vin_v=12 fs=500k tclk={1/fs}
.param lval=10u rdcr=10m cval=100u esrval=10m rload=3.3
.param ra=2300 rb=1000 vref=1
.param r1=10k r2=27.51k r3=101.7 c1=36.35p c2=2.299n c3=6.261n
.param vramp=2
.param gm_oa=1000 ro_oa=100 co_oa=100p
.param kc=30
.param vgate=5

* --- plausible inline BSIM4 model, NOT calibrated to any real process
* (deliberately simple: capmod=0, most extra-term flags off, same
* minimisation style as tests/fixtures/stb3_bsim4_cgd.cir) ---
.model nch4 nmos level=54 version=4.8.2
+ mobmod=0 capmod=0 igcmod=0 igbmod=0 rdsmod=0 rbodymod=0 rgatemod=0 acnqsmod=0
+ toxe=5e-9 toxp=5e-9 toxm=5e-9
+ vth0=0.7 k1=0.4 k2=0 k3=0 w0=2.5e-6
+ u0=300 vsat=1.1e5
+ cgso=2e-10 cgdo=2e-10 cgbo=0 cgsl=0 cgdl=0
+ cf=0 cjs=1e-4 cjd=1e-4 cjswd=1e-10 cjswgd=1e-10

Vin vin 0 DC {vin_v}

* --- PWM comparator (as r3): pwm in [0,1], high = HS on ---
Vramp ramp 0 PULSE(0 {vramp} 0 {0.97*tclk} {0.03*tclk} 1n {tclk})
Bcmp pwm 0 V = 0.5*(1+tanh({kc}*(V(opout)-V(ramp))))
Bpwmls pwm_ls 0 V = 1-V(pwm)

* --- gate drive: ideal bootstrap-style level shifters (not BSIM4 -- the
* driver itself is not the device-eval target here) ---
Ehsgate hsgate_bus sw pwm 0 {vgate}
Elsgate lsgate_bus 0 pwm_ls 0 {vgate}

* --- HS switch: 4-finger BSIM4 array, drain=vin bus, source=sw bus ---
Mhs0 hs_d0 hs_g0 hs_s0 hs_s0 nch4 w=0.015 l=0.35u
Rfdhs0 vin hs_d0 0.02
Rfghs0 hsgate_bus hs_g0 0.02
Rfshs0 sw hs_s0 0.02
Mhs1 hs_d1 hs_g1 hs_s1 hs_s1 nch4 w=0.015 l=0.35u
Rfdhs1 vin hs_d1 0.02
Rfghs1 hsgate_bus hs_g1 0.02
Rfshs1 sw hs_s1 0.02
Mhs2 hs_d2 hs_g2 hs_s2 hs_s2 nch4 w=0.015 l=0.35u
Rfdhs2 vin hs_d2 0.02
Rfghs2 hsgate_bus hs_g2 0.02
Rfshs2 sw hs_s2 0.02
Mhs3 hs_d3 hs_g3 hs_s3 hs_s3 nch4 w=0.015 l=0.35u
Rfdhs3 vin hs_d3 0.02
Rfghs3 hsgate_bus hs_g3 0.02
Rfshs3 sw hs_s3 0.02

* --- LS switch: 4-finger BSIM4 array, drain=sw bus, source=gnd ---
Mls0 ls_d0 ls_g0 ls_s0 ls_s0 nch4 w=0.015 l=0.35u
Rfdls0 sw ls_d0 0.02
Rfgls0 lsgate_bus ls_g0 0.02
Rfsls0 0 ls_s0 0.02
Mls1 ls_d1 ls_g1 ls_s1 ls_s1 nch4 w=0.015 l=0.35u
Rfdls1 sw ls_d1 0.02
Rfgls1 lsgate_bus ls_g1 0.02
Rfsls1 0 ls_s1 0.02
Mls2 ls_d2 ls_g2 ls_s2 ls_s2 nch4 w=0.015 l=0.35u
Rfdls2 sw ls_d2 0.02
Rfgls2 lsgate_bus ls_g2 0.02
Rfsls2 0 ls_s2 0.02
Mls3 ls_d3 ls_g3 ls_s3 ls_s3 nch4 w=0.015 l=0.35u
Rfdls3 sw ls_d3 0.02
Rfgls3 lsgate_bus ls_g3 0.02
Rfsls3 0 ls_s3 0.02

Csw sw 0 100p
L1 sw swl {lval} IC=0
Rdcr swl vout {rdcr}
Resr vout cx {esrval}
Cout cx 0 {cval} IC=0
Rload vout 0 {rload}

* --- feedback divider + type-III error amp (as r3, inline op-amp) ---
Ra vout fbnode {ra}
Rb fbnode 0 {rb}

Vrefsrc vrefnode 0 DC {vref}
Goa opout 0 vrefnode compin {gm_oa}
Roa opout 0 {ro_oa}
Coa opout 0 {co_oa}

R1in fbnode compin {r1}
R3in fbnode n3 {r3}
C3in n3 compin {c3}
C1f compin opout {c1}
R2f compin n2 {r2}
C2f n2 opout {c2}

* --- synthetic PEX net: tree topology, 3280 nodes, coupled onto vout ---
Rtreecouple vout tree_0 10
* tree-shaped synthetic PEX net: branch=3 depth=7, rtrace0=0.2 (x1.6/level), cplane0=2e-14 (x0.6/level), local-mesh-stride=3, coupling-caps=0
