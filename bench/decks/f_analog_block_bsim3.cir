.tran 0.5n 2000.0n 0
.options reltol=1e-3

.control
set filetype=ascii
rusage cputime
run
rusage cputime
meas tran wave_out0_mid find v(out0) at=1000.0n
meas tran wave_out0_end find v(out0) at=1990.0n
meas tran wave_out30_mid find v(out30) at=1000.0n
meas tran wave_out30_end find v(out30) at=1990.0n
meas tran wave_out59_mid find v(out59) at=1000.0n
meas tran wave_out59_end find v(out59) at=1990.0n
meas tran wave_out0_settle AVG v(out0) FROM=1500.0n TO=2000.0n
print wave_out0_mid wave_out0_end
wrdata $HOME/Work/data/ngspice_augmentation/accel/bench/f_analog_block_bsim3/wave.txt v(out0) v(out30) v(out59)
rusage cputime
quit
.endc
.end
