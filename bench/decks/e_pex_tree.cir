.tran 10n 25.0u 0 uic
.options reltol=1e-3 abstol=1e-9 vntol=1e-6 klu

.control
set filetype=ascii
rusage cputime
run
rusage cputime
meas tran vout_avg_final AVG v(vout) FROM=22.5u TO=25.0u
meas tran vout_max_final MAX v(vout) FROM=22.5u TO=25.0u
meas tran vout_min_final MIN v(vout) FROM=22.5u TO=25.0u
let vout_ripple = vout_max_final - vout_min_final
meas tran duty_meas AVG v(pwm) FROM=11.25u TO=12.5u
meas tran wave_t1 find v(vout) at=6.25u
meas tran wave_t2 find v(vout) at=12.5u
meas tran wave_t3 find v(vout) at=18.75u
meas tran wave_t4 find v(vout) at=25.0u
meas tran wave_sw_t1 find v(sw) at=12.5u
meas tran wave_mesh_far find v(tree_11110) at=25.0u
print vout_avg_final vout_max_final vout_min_final vout_ripple duty_meas wave_t1 wave_t2 wave_t3 wave_t4 wave_sw_t1 wave_mesh_far
rusage cputime
wrdata $HOME/Work/data/ngspice_augmentation/accel/bench/e_pex_tree/wave.txt v(vout) v(sw) i(l1)
quit
.endc
.end
