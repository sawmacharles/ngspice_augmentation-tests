* 399 parasitic capacitors, 480 parasitic resistors

.control
set filetype=ascii
save v(vout) v(opout) v(sw) i(L1) i(Vin)
tran 2n 400u 0 uic
meas tran vout_avg AVG v(vout) FROM=380u TO=400u
meas tran vout_max MAX v(vout) FROM=390u TO=400u
meas tran vout_min MIN v(vout) FROM=390u TO=400u
print vout_avg vout_max vout_min
.endc
.end
